{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "blinkled_linux: LUCKFOX_LYRA_ULTRA",

            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "192.168.0.43:2345",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "objdumpPath": "/usr/bin/objdump",
            "executable": "${workspaceFolder}/${config:dq.debugTarget}",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "blinkled_linux: LUCKFOX_LYRA_ULTRA",
            "preLaunchCommands": [
                "set confirm off",
                "python gdb.execute('kill') if gdb.selected_inferior().pid else None"
            ],
            "runToEntryPoint": "",
            "overrideLaunchCommands": [
                "remote put ${workspaceFolder}/${config:dq.debugTarget} ${config:dq.debugTarget}",
                "set remote exec-file ${config:dq.debugTarget}",
                "starti"
            ],
            "showDevDebugOutput": "raw"
        },
        {
            "name": "blinkled_linux: SSH",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/${config:dq.debugTarget}",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "preLaunchTask": "Deploy blinkled",

            "debugServerPath": "/usr/bin/ssh",
            "debugServerArgs": "-T root@192.168.0.43 \"mv -f /work/blinkled/${config:dq.debugTarget}.new /work/blinkled/${config:dq.debugTarget} && exec gdbserver --once :2345 /work/blinkled/${config:dq.debugTarget}\"",
            "serverStarted": "Listening on port 2345",
            "filterStderr": true,

            "miDebuggerServerAddress": "192.168.0.43:2345",
            "launchCompleteCommand": "exec-continue"
        }
    ]
}

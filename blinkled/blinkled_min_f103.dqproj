// DQ project file for the "blinkled" test

var VIHAL = PackagePath('vihal')

main      = 'blinkled.dq'
output    = '\{PROJECT_NAME}.elf'
build_tag = '\{PROJECT_NAME}'

link     = true

optlevel  = 0
lto       = false
debuginfo = true

target      = 'arm_m3-bare'
linkerpath  = '\{VIHAL}/core/ld'
linkoption  = '--gc-sections'
pkg         = 'vihal_board:./vihal_board'
linkscript  = '\{VIHAL}/armm/stm32/f1/STM32F103x8.ld'

linkoption = '--Map=\{PROJECT_NAME}.map'

define BOARD_MIN_F103

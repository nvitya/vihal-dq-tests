
// The VIHAL requires this module, at least the MCU registers must be included with "use ... reexport"

#ifdef BOARD_NUCLEO_F746

    use vihal/armm/stm32/f7/stm32f746   reexport

#elifdef BOARD_DISCOVERY_F072

    use vihal/armm/stm32/f0/stm32f070   reexport

#elifdef BOARD_RPI_PICO

    use vihal/armm/rp/20/rp2040  reexport

#else
    #error "Unknown board"
#endif

// you can put board specific constants here, but don't use vihal modules



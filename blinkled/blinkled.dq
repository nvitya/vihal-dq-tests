// Blinking led main for multiple boards

use vihal/armm/armm_startup
use vihal/armm/armm_vector_table

use vihal/platform
use vihal/clockcnt
use vihal/hwpins
use vihal/hwclk

use board/board_pins

var g_hbcnt : int = 0
var g_clk : uint32 = 0

function dq_module_init()  [[external('dq_module_init')]]

function _start(self_flash : int)  [[cexport]]:

    InitMemRegions()  // in armm_startup.dq

    dq_module_init()

    ArmmVectorTableInit()

    SystemCoreClock = MCU_INTERNAL_RC_SPEED
    HwclkInit(EXTERNAL_XTAL_HZ, MAX_CLOCK_SPEED)

    ClockCntInit()

    BoardPinsInit()

    var clk_per_sec : uint = SystemCoreClock IDIV 2
    var prev_clk    : uint = ClockCnt()

    while true:
        g_clk = ClockCnt()
        if g_clk - prev_clk > clk_per_sec:
            g_hbcnt += 1
            led1.SetTo((g_hbcnt >> 0) AND 1)
            #if LED_COUNT > 1
                led2.SetTo((g_hbcnt >> 1) AND 1)
            #endif
            #if LED_COUNT > 2
                led3.SetTo((g_hbcnt >> 2) AND 1)
            #endif
            #if LED_COUNT > 3
                led4.SetTo((g_hbcnt >> 3) AND 1)
            #endif

            prev_clk = g_clk
        endif
    endwhile
endfunc

// Blinking led main for multiple boards

use vihal/platform
use vihal/core/platform_init

use vihal/clockcnt
use vihal/hwpins
use vihal/hwclk

use board/board_pins

var g_hbcnt : int = 0

func _start(self_flash : int)  [[cexport, used, section('.startup')]]:

    InitMemRegions()  // in armm_startup.dq

    McuVectorTableInit()  // relocate the vector table if supported

    DqModuleInit()    // Initialize DQ modules, call embedded object constructors

    SystemCoreClock = MCU_INTERNAL_RC_SPEED
    HwClkInit(EXTERNAL_XTAL_HZ, MAX_CLOCK_SPEED)

    ClockCntInit()

    BoardPinsInit()

    var hbclocks : uint = SystemCoreClock div 20   // start blinking fast
    var t0 : uint = ClockCnt()
    var t1 : uint

    while true:
        t1 = ClockCnt()
        if t1 - t0 > hbclocks:
            g_hbcnt += 1
            led1.SetTo((g_hbcnt >> 0) & 1)
            #if LED_COUNT > 1
                led2.SetTo((g_hbcnt >> 1) & 1)
            #endif
            #if LED_COUNT > 2
                led3.SetTo((g_hbcnt >> 2) & 1)
            #endif
            #if LED_COUNT > 3
                led4.SetTo((g_hbcnt >> 3) & 1)
            #endif

            if g_hbcnt > 20:
                hbclocks = SystemCoreClock div 2  // slow down to 0.5 s
            endif
            t0 = t1
        endif
    endwhile
endfunc

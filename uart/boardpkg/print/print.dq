
// print implementation using the console uart

func Print(fmt : strview) [[overload]]
func Print(fmt : strview, args : []anyvalue) [[overload]]
func PrintLn() [[overload]]
func PrintLn(fmt : strview) [[overload]]
func PrintLn(fmt : strview, args : []anyvalue) [[overload]]
func PrintFlush()

implementation

use rtl/textformat
use vihal/hwuart
use board/board_pins

object OTextSinkUart(OTextSink):
    uart : OHwUart

    func *Create():
        inherited Create()
        uart = @board_pins.conuart
    endfunc

    func Write(atext : strview) [[override]]:
        for i : int = 0 count atext.length:
            uart.SendByte(Ord(atext[i]))
        endfor
    endfunc

    func WriteChar(ch : char)   [[override]]:
        uart.SendByte(Ord(ch))
    endfunc
endobject

var conuart_sink      <- OTextSinkUart()
var conuart_formatter <- OTextFormatter(conuart_sink)

func Print(fmt : strview) [[overload]]:
    conuart_sink.Write(fmt)
endfunc

func Print(fmt : strview, args : []anyvalue) [[overload]]:
    conuart_formatter.Format(fmt, args)
endfunc

func PrintLn() [[overload]]:
    conuart_sink.WriteChar('\r')
    conuart_sink.WriteChar('\n')
endfunc

func PrintLn(fmt : strview) [[overload]]:
    conuart_sink.Write(fmt)
    conuart_sink.WriteChar('\r')
    conuart_sink.WriteChar('\n')
endfunc

func PrintLn(fmt : strview, args : []anyvalue) [[overload]]:
    conuart_formatter.Format(fmt, args)
    conuart_sink.WriteChar('\r')
    conuart_sink.WriteChar('\n')
endfunc

func PrintFlush():
    //
endfunc

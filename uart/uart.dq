// Uart main for multiple boards

use vihal/platform
use vihal/core/platform_init

use vihal/clockcnt
use vihal/hwclk

use board/board_pins

use rtl/mem
use rtl/strfunc

use print

var g_hbcnt : int = 0

func dq_module_init()  [[external('dq_module_init')]]

func _start(self_flash : int)  [[cexport, used, section('.startup')]]:

    InitMemRegions()  // in armm_startup.dq

    McuVectorTableInit()  // relocate the vector table if supported

    DqModuleInit()    // Initialize DQ modules, call embedded object constructors

    Mcu_EnableFpu()
    Mcu_EnableICache()

    var bp : ^byte = ^byte(MemAlloc(1024))

    SystemCoreClock = MCU_INTERNAL_RC_SPEED
    HwClkInit(EXTERNAL_XTAL_HZ, MAX_CLOCK_SPEED)

    ClockCntInit()

    BoardPinsInit()

    //var av : anyvalue
    //var s : str = "abc"

    PrintLn('--------------------------------------------------------')
    PrintLn('Hello from VIHAL-DQ!')

    var hbclocks : uint = SystemCoreClock div 20   // start blinking fast
    var t0 : uint = ClockCnt()
    var t1 : uint
    var t2 : uint
    var t3 : uint

    t0 = ClockCnt()
    t1 = ClockCnt()
    t2 = ClockCnt()
    t3 = ClockCnt()

    PrintLn('Consecutive ClockCnt(): {}, {}, {}', [t1-t0, t2-t1, t3-t2])

    while true:
        t1 = ClockCnt()
        if t1 - t0 > hbclocks:
            g_hbcnt += 1

            led1.SetTo((g_hbcnt >> 0) & 1)
          #if LED_COUNT > 1
            led2.SetTo((g_hbcnt >> 1) & 1)
          #endif
          #if LED_COUNT > 2
            led3.SetTo((g_hbcnt >> 2) & 1)
          #endif
          #if LED_COUNT > 3
            led4.SetTo((g_hbcnt >> 3) & 1)
          #endif

            //conuart.SendByte(0x55)
            PrintLn('hbcounter = {}', [g_hbcnt])

            if g_hbcnt > 20:
                hbclocks = SystemCoreClock div 2  // slow down to 0.5 s
            endif
            t0 = t1
        endif
    endwhile
endfunc

// DQ project file for the "cpuonly" test

var VIHAL = PackagePath('vihal')

main     = 'cpuonly.dq'
output   = '${PROJECT_NAME}.elf'

link     = true

optlevel  = 0
lto       = false
debuginfo = true

define BOARD_MIBOW_ESP32C3

target      = 'rv32imac_bare'
linkerpath  = '${VIHAL}/core/ld'
linkoption  = '--gc-sections'
packagepath = './boardpkg'
linkscript  = '${VIHAL}/rv32i/esp/32c3/ESP32C3_ram_256-128.ld'


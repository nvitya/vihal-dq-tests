
// compile with:
// dq-comp --target=arm_m7f-bare -O0 -g test1.dq

use ./armm_startup
use ./armm_vector_table

var g_hbcnt : int = 0

//function dq_module_init()  [[external('dq_module_init')]]

function _start(self_flash : int)  [[cexport]]:

    InitMemRegions()  // in armm_startup.dq

    //dq_module_init()

    while true:
        g_hbcnt += 1
    endwhile
endfunc

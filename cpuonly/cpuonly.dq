
use vihal/core/platform_init

var g_hbcnt : int = 0

func _start(self_flash : int)  [[cexport]]:

    // Initialize memory regions
    InitMemRegions()      // in platform_init

    // Vector table relocation, when supported
    McuVectorTableInit()  // since this will

    while true:
        g_hbcnt += 1
    endwhile
endfunc

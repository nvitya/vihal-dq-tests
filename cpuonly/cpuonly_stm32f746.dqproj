// DQ project file for the "cpuonly" test

var VIHAL = '/workpr/vihal-dq'

main     = 'cpuonly.dq'
output   = '${PROJECT_NAME}.elf'

link     = true

optlevel  = 0
lto       = false
debuginfo = true

target     = 'arm_m7f-bare'
linkerpath = '${VIHAL}/core/ld'
linkoption = '--gc-sections'
linkscript = '${VIHAL}/armm/stm32/f7/STM32F750x8_ram.ld'


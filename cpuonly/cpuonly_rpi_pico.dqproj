// DQ project file for the "cpuonly" test

var VIHAL = PackagePath('vihal')

main     = 'cpuonly.dq'
output   = '${PROJECT_NAME}.elf'

link     = true

optlevel  = 0
lto       = false
debuginfo = true

target      = 'arm_m7f-bare'
linkerpath  = '${VIHAL}/core/ld'
linkoption  = '--gc-sections'
pkg         = 'vihal_board:./vihal_board'
linkscript  = '${VIHAL}/armm/rp/_20/RP2040_ram.ld'

define BOARD_RPI_PICO
